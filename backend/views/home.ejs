<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
</head>

<body>
    <h1>URL Shortner</h1>

    <form method="post" action="/url">

        <label for="">URL to be shortend</label>
        <input id="input" type="text" name="url" placeholder="https:example.com">
        <button type="submit">Generate</button>

    </form>

    <br>

    <% if (locals.id) { %>
        <p>url generated: http://localhost:5000/url/<%= id %>
        </p>
        <% } %>

            <% if (locals.urls.length > 0) { %>

                <table border="1">
                    <thead>
                        <tr>
                            <th>S No</th>
                            <th>shortend url</th>
                            <th>original url</th>
                            <th>times used</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% urls.forEach((url, index)=> { %>
                            <tr>
                                <td><%= index + 1 %></td>
                                <td>http://localhost:5000/url/<%= url.shortId %></td>
                                <td><%= url.redirectUrl %></td>
                                <td><%= url.visitHistory.length %></td>
                            </tr>

                            <% }) %>

                    </tbody>

                </table>
                <% } %>
</body>

</html>